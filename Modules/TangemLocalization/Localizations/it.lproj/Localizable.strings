"collectibles_stories_buyer_subtitle" = "Riceva l'85–93%% del valore assicurato della sua carta entro 72 ore. Accetti l'offerta in USDC, oppure tocchi per prelevare la carta nel suo cold wallet";
"collectibles_stories_buyer_title" = "C'è sempre un acquirente";
"collectibles_stories_graded_subtitle" = "Ogni carta è valutata da professionisti, quindi l’autenticità è garantita. A ciascuna corrisponde, in rapporto 1:1, una carta fisica nella sua custodia sigillata, conservata in un caveau fisico assicurato";
"collectibles_stories_graded_title" = "Pack digitali.\nCarte da collezione fisiche.";
"collectibles_stories_ownership_subtitle" = "Può lasciarla nel caveau fisico, farla consegnare al suo indirizzo o inviarla a un amico come regalo: può richiedere la carta nella custodia sigillata in qualsiasi momento";
"collectibles_stories_ownership_title" = "La carta è sua, in ogni caso";
"collectibles_stories_security_subtitle" = "Un solo tocco configura lo smart contract Solana, di proprietà del suo cold wallet. Collezioni senza avvicinare la carta al telefono; ogni prelievo richiede comunque la sua carta";
"collectibles_stories_security_title" = "Alta sicurezza, design senza scansione";
"collectibles_stories_transparency_subtitle" = "Esamini ogni carta prima di acquistare e guardi le aperture in diretta dalla blockchain, con il portafoglio di ogni collezionista e il valore della carta. Tutto nell’app";
"collectibles_stories_transparency_title" = "Nessun segreto";
"collectibles_turbo_mode_bottomsheet_message" = "La modalità Turbo rivende automaticamente ogni carta di rarità Comune. Cerchi le carte più ambite alla massima velocità";
